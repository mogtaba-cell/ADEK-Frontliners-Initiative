# App
NEXT_PUBLIC_APP_NAME="ADEK Frontliners Initiative"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Cron/export security
CRON_SECRET="replace-with-long-random-value"
EXPORT_ENCRYPTION_SECRET="replace-with-32-plus-char-secret"

# Google Shared Drive export integration
GOOGLE_SHARED_DRIVE_FOLDER_ID="0AOSMC6EIWssCUk9PVA"
GOOGLE_CLIENT_EMAIL="service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# First admin bootstrap
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisStrongPassword123!"
ADMIN_FULL_NAME="System Admin"
